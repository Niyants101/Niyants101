{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "niyant-random-profile",
  "main": "./profile-randomizer/worker.mjs",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/profile.gif",
      "/profile-wide.gif",
      "/profile-laptop.gif",
      "/profile-tablet.gif",
      "/profile-mobile.gif",
      "/profile-micro.gif"
    ]
  }
}
